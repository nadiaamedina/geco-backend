generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model asignaciones {
  id               Int         @id @default(autoincrement())
  voluntario_id    Int
  emergencia_id    Int
  tarea            String      @db.VarChar(160)
  fecha_asignacion DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  emergencias      emergencias @relation(fields: [emergencia_id], references: [id], onDelete: Cascade, map: "fk_asignaciones_emergencia")
  voluntarios      voluntarios @relation(fields: [voluntario_id], references: [id], onDelete: Cascade, map: "fk_asignaciones_voluntario")

  @@unique([voluntario_id, emergencia_id], map: "uq_asignaciones_voluntario_emergencia")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model emergencias {
  id           Int            @id @default(autoincrement())
  titulo       String         @db.VarChar(160)
  descripcion  String?
  gravedad     String         @db.VarChar(10)
  estado       String         @default("activa") @db.VarChar(20)
  fecha        DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  zona         String         @db.VarChar(120)
  afectados    Int            @default(0)
  usuario_id   Int
  asignaciones asignaciones[]
  usuarios     usuarios       @relation(fields: [usuario_id], references: [id], map: "fk_emergencias_usuario")
  solicitudes  solicitudes[]

  @@index([estado], map: "ix_emergencias_estado")
  @@index([gravedad], map: "ix_emergencias_gravedad")
}

model mensajes_contacto {
  id      Int      @id @default(autoincrement())
  nombre  String   @db.VarChar(120)
  email   String   @db.VarChar(120)
  asunto  String   @db.VarChar(160)
  mensaje String
  fecha   DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recursos {
  id                   Int     @id @default(autoincrement())
  nombre               String  @db.VarChar(120)
  cantidad_disponible  Decimal @default(0) @db.Decimal(10, 2)
  cantidad_distribuida Decimal @default(0) @db.Decimal(10, 2)
  unidad               String  @db.VarChar(20)
  estado               String  @default("suficiente") @db.VarChar(20)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model refugios {
  id        Int    @id @default(autoincrement())
  nombre    String @db.VarChar(120)
  direccion String @db.VarChar(200)
  capacidad Int
  alojados  Int    @default(0)
  estado    String @default("activo") @db.VarChar(20)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model solicitudes {
  id                Int         @id @default(autoincrement())
  titulo            String      @db.VarChar(160)
  descripcion       String?
  prioridad         String      @db.VarChar(10)
  estado            String      @default("pendiente") @db.VarChar(20)
  telefono_contacto String      @db.VarChar(30)
  fecha             DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  emergencia_id     Int
  emergencias       emergencias @relation(fields: [emergencia_id], references: [id], map: "fk_solicitudes_emergencia")

  @@index([estado], map: "ix_solicitudes_estado")
  @@index([prioridad], map: "ix_solicitudes_prioridad")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model usuarios {
  id          Int           @id @default(autoincrement())
  nombre      String        @db.VarChar(60)
  apellido    String        @db.VarChar(60)
  email       String        @unique(map: "uq_usuarios_email") @db.VarChar(120)
  contrasena  String        @db.VarChar(255)
  rol         String        @db.VarChar(20)
  creado_en   DateTime      @default(now()) @db.Timestamp(6)
  emergencias emergencias[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model voluntarios {
  id             Int            @id @default(autoincrement())
  nombre         String         @db.VarChar(120)
  telefono       String         @db.VarChar(30)
  habilidad      String         @db.VarChar(120)
  disponibilidad String         @db.VarChar(40)
  estado         String         @default("disponible") @db.VarChar(20)
  asignaciones   asignaciones[]
}
